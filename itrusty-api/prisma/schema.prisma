// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  MOTORISTA
  OFICINA
}

enum AgendamentoStatus {
  AGUARDANDO
  CONFIRMADO
  RECUSADO
  CONCLUIDO
  CANCELADO
}

enum DiaSemana {
  SEG
  TER
  QUA
  QUI
  SEX
  SAB
  DOM
}

enum CategoriaServico {
  MECANICA
  ESTETICA
  ELETRICA
  MOTOR
  SUSPENSAO
  PNEUS
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String?  @map("password_hash")
  role         Role?
  fcmToken     String?  @map("fcm_token")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  provider     String?

  motorista     Motorista?
  oficina       Oficina?
  refreshTokens RefreshToken[]
  notificacoes  Notificacao[]

  @@map("users")
}

model Notificacao {
 id        String   @id @default(uuid())
 userId    String   @map("user_id")
 user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 titulo    String
 corpo     String
 lida      Boolean  @default(false)
criadaEm DateTime @default(now()) @map("criada_em")
 
 @@index([userId, lida])
  @@map("notificacoes")
 }

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Motorista {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cep    String?
  rua    String?
  numero String?
  bairro String?
  cidade String?
  estado String?

  veiculos     Veiculo[]
  agendamentos Agendamento[]

  @@map("motoristas")
}

model Veiculo {
  id          String    @id @default(uuid())
  motoristaId String    @map("motorista_id")
  motorista   Motorista @relation(fields: [motoristaId], references: [id], onDelete: Cascade)

  marca  String
  modelo String
  ano    Int
  placa  String @unique

  agendamentos Agendamento[]

  @@map("veiculos")
}

model Oficina {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nome       String
  cnpj       String?           @unique
  telefone   String?
  fotoUrl    String?           @map("foto_url")
  categorias CategoriaServico[]

  cep       String?
  rua       String?
  numero    String?
  bairro    String?
  cidade    String?
  estado    String?
  latitude  Float?
  longitude Float?

  servicos     Servico[]
  horarios     OficinaHorario[]
  bloqueios    OficinaBloqueio[]
  agendamentos Agendamento[]

  @@map("oficinas")
}

model OficinaHorario {
  id        String    @id @default(uuid())
  oficinaId String    @map("oficina_id")
  oficina   Oficina   @relation(fields: [oficinaId], references: [id], onDelete: Cascade)

  dia        DiaSemana
  aberto     Boolean   @default(true)
  abertura   String
  fechamento String

  @@unique([oficinaId, dia])
  @@map("oficina_horarios")
}

model OficinaBloqueio {
  id        String   @id @default(uuid())
  oficinaId String   @map("oficina_id")
  oficina   Oficina  @relation(fields: [oficinaId], references: [id], onDelete: Cascade)

  data      DateTime @db.Date
  motivo    String?

  @@map("oficina_bloqueios")
}

model Servico {
  id        String  @id @default(uuid())
  oficinaId String  @map("oficina_id")
  oficina   Oficina @relation(fields: [oficinaId], references: [id], onDelete: Cascade)

  nome           String
  descricao      String?
  duracaoMinutos Int     @map("duracao_minutos")
  preco          Decimal @db.Decimal(10, 2)
  ativo          Boolean @default(true)

  agendamentos Agendamento[]

  @@map("servicos")
}

model Agendamento {
  id String @id @default(uuid())

  motoristaId String    @map("motorista_id")
  motorista   Motorista @relation(fields: [motoristaId], references: [id])

  oficinaId String  @map("oficina_id")
  oficina   Oficina @relation(fields: [oficinaId], references: [id])

  servicoId String  @map("servico_id")
  servico   Servico @relation(fields: [servicoId], references: [id])

  veiculoId String  @map("veiculo_id")
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id])

  dataServico   DateTime          @map("data_servico") @db.Date
  horaInicio    String            @map("hora_inicio")
  horaFim       String            @map("hora_fim")
  status        AgendamentoStatus @default(AGUARDANDO)
  observacao    String?
  precoEstimado Decimal           @map("preco_estimado") @db.Decimal(10, 2)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([oficinaId, dataServico])
  @@index([motoristaId])
  @@map("agendamentos")
}
